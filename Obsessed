<div class="toast" id="toast"></div>

<script>
// ── DATA ──────────────────────────────────────────────────────────────────
const G = (k,d)=>{try{return JSON.parse(localStorage.getItem('ob_'+k))??d;}catch{return d;}};
const S = (k,v)=>localStorage.setItem('ob_'+k,JSON.stringify(v));

let habits    = G('habits',[]);
let comps     = G('comps',{});   // {date:{habitId:true}}
let radar     = G('radar',{academics:0,physique:0,work:0,social:0});
let sessions  = G('sessions',[]); // [{date,sec}]
let subjects  = G('subjects',[]);
let mmarks    = G('marks',{});   // {sid:[{id,date,name,score,max}]}
let badges    = G('badges',[]);
let startDate = G('sdate', todayS());
let bestStr   = G('bstr',0);
let totalC    = G('totalC',0);

function save(){
  S('habits',habits);S('comps',comps);S('radar',radar);S('sessions',sessions);
  S('subjects',subjects);S('marks',mmarks);S('badges',badges);S('bstr',bestStr);S('totalC',totalC);
}

// ── UTILS ─────────────────────────────────────────────────────────────────
function todayS(){return new Date().toISOString().split('T')[0];}
function fmtDate(s){const d=new Date(s+'T00:00:00');return d.toLocaleDateString('en-US',{month:'short',day:'numeric'});}
function uid(){return Date.now().toString(36)+Math.random().toString(36).slice(2,5);}
function todayWD(){return (new Date().getDay()+6)%7;} // 0=Mon
function dsWD(ds){const d=new Date(ds+'T00:00:00');return (d.getDay()+6)%7;}
function fmtTime(t){if(!t)return'';const[h,m]=t.split(':');const hh=+h;return`${hh>12?hh-12:hh||12}:${m} ${hh>=12?'PM':'AM'}`;}
function fmtSec(s){const h=Math.floor(s/3600),m=Math.floor((s%3600)/60);return`${h}h ${m}m`;}

function toast(msg,ic='✓'){
  const t=document.getElementById('toast');
  t.textContent=ic+'  '+msg;t.classList.add('show');
  setTimeout(()=>t.classList.remove('show'),2600);
}

function animN(id,to,suf=''){
  const el=document.getElementById(id);if(!el)return;
  const from=parseInt(el.textContent)||0;
  const dur=900,t0=performance.now();
  const run=now=>{
    const p=Math.min((now-t0)/dur,1);
    const e=1-Math.pow(1-p,3);
    el.textContent=Math.round(from+(to-from)*e)+suf;
    if(p<1)requestAnimationFrame(run);
  };requestAnimationFrame(run);
}

// ── STREAK ────────────────────────────────────────────────────────────────
function curStreak(){
  let s=0;const today=new Date();
  for(let i=0;i<400;i++){
    const d=new Date(today);d.setDate(d.getDate()-i);
    const ds=d.toISOString().split('T')[0];
    const wd=(d.getDay()+6)%7;
    const dH=habits.filter(h=>h.days.includes(wd));
    if(!dH.length){if(i>0)break;continue;}
    const done=dH.filter(h=>comps[ds]?.[h.id]).length;
    if(done===dH.length)s++;
    else if(i===0)break;
    else break;
  }return s;
}

function getLevel(){return Math.floor(totalC/10)+1;}

// ── NAV ───────────────────────────────────────────────────────────────────
let cur='home';
const VIEWS=['home','habits','timer','marks','stats'];

function sv(name){
  if(name===cur)return;
  const old=document.getElementById('v-'+cur);
  const nxt=document.getElementById('v-'+name);
  old.classList.remove('active');
  old.classList.add('slide-out-left');
  setTimeout(()=>old.classList.remove('slide-out-left'),420);
  nxt.classList.add('active');
  document.querySelectorAll('.nb').forEach(b=>b.classList.remove('active'));
  const nb=document.getElementById('nb-'+name);
  if(nb)nb.classList.add('active');
  cur=name;
  if(name==='home')rHome();
  if(name==='habits')rHabits();
  if(name==='stats'){rStats();rGrids();drawRadar(0);}
  if(name==='marks')rMarks();
  if(name==='timer'){updTDisp();rStudyC('day');updTodaySt();}
}

// ── HOME ──────────────────────────────────────────────────────────────────
function rHome(){rWCal();rTodayH();updHero();updStreak();rBadges();}

function updHero(){
  const t=getTH().length,d=getTHDone().length;
  const pct=t===0?0:Math.round(d/t*100);
  animN('heroPct',pct,'%');
  document.getElementById('heroSub').textContent=`${d} of ${t} habits achieved`;
}

function getTH(){
  const wd=todayWD();
  return habits.filter(h=>h.days.includes(wd));
}
function getTHDone(){return getTH().filter(h=>comps[todayS()]?.[h.id]);}

function rWCal(){
  const cal=document.getElementById('wcal');
  const today=new Date(),days=['MON','TUE','WED','THU','FRI','SAT','SUN'];
  const mon=new Date(today);
  mon.setDate(today.getDate()-todayWD());
  cal.innerHTML='';
  for(let i=0;i<7;i++){
    const d=new Date(mon);d.setDate(mon.getDate()+i);
    const ds=d.toISOString().split('T')[0];
    const isT=d.toDateString()===today.toDateString();
    const dH=habits.filter(h=>h.days.includes(i));
    const hasDone=dH.length>0&&dH.some(h=>comps[ds]?.[h.id]);
    const el=document.createElement('div');
    el.className='wd'+(isT?' today':'')+(hasDone?' done':'');
    el.innerHTML=`<span class="wd-n">${days[i]}</span><div class="wd-d">${d.getDate()}</div><div class="dot"></div>`;
    cal.appendChild(el);
  }
}

function updStreak(){
  const s=curStreak();
  document.getElementById('streakB').textContent=`🔥 ${s} day streak`;
  const lv=getLevel();
  document.getElementById('lvlB').innerHTML=`<div class="lvlbadge">⚡ Level ${lv}</div>`;
}

function rTodayH(){
  const c=document.getElementById('todayH');
  const th=getTH();
  if(!th.length){c.innerHTML='<div class="es"><div class="es-ico">🌟</div><div class="es-t">No habits today.<br>Tap + to add one!</div></div>';return;}
  c.innerHTML='';
  th.forEach(h=>{
    const done=!!comps[todayS()]?.[h.id];
    const el=document.createElement('div');
    el.className='hi'+(done?' done-h':'');
    el.dataset.id=h.id;
    const ch=(h.cats||[]).map(c=>`<span class="hcat c-${c[0]}">${c}</span>`).join('');
    el.innerHTML=`
      <div class="h-ico">${h.emo||'⭐'}</div>
      <div class="h-info">
        <div class="h-nm">${h.name}</div>
        <div class="h-mt">${h.time?'⏰ '+fmtTime(h.time):'All day'}</div>
        <div class="h-cats">${ch}</div>
      </div>
      <div class="h-chk"><svg fill="none" viewBox="0 0 24 24" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg></div>`;
    el.addEventListener('click',function(e){ripple(this,e);toggleH(h.id);});
    c.appendChild(el);
  });
}

function ripple(el,e){
  const r=el.getBoundingClientRect();
  const sp=document.createElement('span');
  sp.className='rpl';
  sp.style.cssText=`left:${e.clientX-r.left}px;top:${e.clientY-r.top}px;width:18px;height:18px;transform:translate(-50%,-50%) scale(0);position:absolute;`;
  el.appendChild(sp);setTimeout(()=>sp.remove(),700);
}

function toggleH(id){
  const ds=todayS();
  if(!comps[ds])comps[ds]={};
  const was=comps[ds][id];
  const h=habits.find(x=>x.id===id);
  if(!was){
    comps[ds][id]=true;
    if(h)(h.cats||[]).forEach(c=>{radar[c]=(radar[c]||0)+1;});
    totalC++;toast('Habit done! 🎉');checkBadges();
  }else{
    delete comps[ds][id];
    if(h)(h.cats||[]).forEach(c=>{radar[c]=Math.max(0,(radar[c]||0)-1);});
    totalC=Math.max(0,totalC-1);
  }
  const s=curStreak();if(s>bestStr)bestStr=s;
  save();rHome();
  if(cur==='stats'){rStats();drawRadar(0);}
}

// ── BADGES ────────────────────────────────────────────────────────────────
const BDEFS=[
  {id:'f1',ico:'🌱',nm:'First Step',req:()=>totalC>=1},
  {id:'s3',ico:'🔥',nm:'3-Day Streak',req:()=>curStreak()>=3},
  {id:'s7',ico:'⚡',nm:'Week Warrior',req:()=>curStreak()>=7},
  {id:'s30',ico:'💎',nm:'Diamond Mind',req:()=>curStreak()>=30},
  {id:'c10',ico:'🏆',nm:'Achiever',req:()=>totalC>=10},
  {id:'c50',ico:'👑',nm:'Champion',req:()=>totalC>=50},
  {id:'c100',ico:'🦋',nm:'Transformed',req:()=>totalC>=100},
  {id:'h3',ico:'🎯',nm:'3 Habits',req:()=>habits.length>=3},
  {id:'h5',ico:'🌊',nm:'5 Habits',req:()=>habits.length>=5},
  {id:'study1',ico:'📚',nm:'Scholar',req:()=>sessions.reduce((a,s)=>a+s.sec,0)>=3600},
  {id:'study5',ico:'🧠',nm:'Deep Worker',req:()=>sessions.reduce((a,s)=>a+s.sec,0)>=18000},
];

function checkBadges(){
  BDEFS.forEach(b=>{
    if(!badges.includes(b.id)&&b.req()){
      badges.push(b.id);save();
      toast(`Badge unlocked: ${b.ico} ${b.nm}!`,'🏅');
    }
  });
}

function rBadges(){
  const r=document.getElementById('badgesR');r.innerHTML='';
  BDEFS.forEach(b=>{
    const e=badges.includes(b.id);
    const d=document.createElement('div');
    d.className='bi'+(e?' earned':' locked');
    d.title=b.nm;
    d.innerHTML=`<div class="bi-ico">${b.ico}</div><div class="bi-nm">${b.nm}</div>`;
    r.appendChild(d);
  });
}

// ── HABITS MANAGE ─────────────────────────────────────────────────────────
function rHabits(){
  const l=document.getElementById('hmList');
