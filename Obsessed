<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
<title>Obsessed</title>
<link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500;9..40,600;9..40,700&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.0/chart.umd.min.js"></script>
<style>
:root {
  --bg: #03030a;
  --bg2: #08080f;
  --card: rgba(255,255,255,0.035);
  --card-hover: rgba(255,255,255,0.055);
  --card-border: rgba(255,255,255,0.07);
  --blue: #3b82f6;
  --blue-sky: #0ea5e9;
  --blue-bright: #60a5fa;
  --blue-glow: rgba(59,130,246,0.28);
  --blue-glow2: rgba(14,165,233,0.18);
  --text: #f0f4ff;
  --text-muted: #5a6a8a;
  --text-dim: #8898aa;
  --green: #22c55e;
  --gold: #f59e0b;
  --nav-h: 74px;
  --r: 20px;
  --rs: 14px;
}
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent;}
html,body{height:100%;overflow:hidden;background:var(--bg);color:var(--text);font-family:'DM Sans',sans-serif;}
body{display:flex;flex-direction:column;}

/* BG GRID */
body::before{content:'';position:fixed;inset:0;background-image:linear-gradient(rgba(59,130,246,0.025) 1px,transparent 1px),linear-gradient(90deg,rgba(59,130,246,0.025) 1px,transparent 1px);background-size:44px 44px;pointer-events:none;z-index:0;}

/* GLOW ORBS */
.orb{position:fixed;border-radius:50%;pointer-events:none;z-index:0;filter:blur(90px);}
.orb1{width:500px;height:500px;top:-180px;left:-80px;background:radial-gradient(circle,rgba(59,130,246,0.07),transparent 70%);}
.orb2{width:360px;height:360px;bottom:50px;right:-80px;background:radial-gradient(circle,rgba(14,165,233,0.05),transparent 70%);}
.orb3{width:280px;height:280px;top:40%;left:40%;background:radial-gradient(circle,rgba(99,102,241,0.04),transparent 70%);}

#app{flex:1;overflow:hidden;position:relative;z-index:1;}

/* VIEWS */
.view{position:absolute;inset:0;overflow-y:auto;padding-bottom:calc(var(--nav-h)+16px);opacity:0;transform:translateX(40px);transition:opacity .38s cubic-bezier(.4,0,.2,1),transform .38s cubic-bezier(.4,0,.2,1);pointer-events:none;scrollbar-width:none;}
.view::-webkit-scrollbar{display:none;}
.view.active{opacity:1;transform:translateX(0);pointer-events:all;}
.view.slide-out-left{opacity:0;transform:translateX(-40px);}

/* NAV */
nav{position:fixed;bottom:0;left:0;right:0;height:var(--nav-h);background:rgba(3,3,10,0.88);backdrop-filter:blur(24px) saturate(180%);border-top:1px solid rgba(255,255,255,0.055);display:flex;align-items:center;justify-content:space-around;padding:0 6px 8px;z-index:100;}
.nb{display:flex;flex-direction:column;align-items:center;gap:4px;cursor:pointer;padding:8px 12px;border-radius:16px;transition:all .25s cubic-bezier(.4,0,.2,1);position:relative;}
.nb svg{width:22px;height:22px;stroke:var(--text-muted);transition:stroke .25s,filter .25s;}
.nb span{font-size:10px;color:var(--text-muted);font-weight:500;transition:color .25s;}
.nb.active svg{stroke:var(--blue-bright);filter:drop-shadow(0 0 8px rgba(96,165,250,.7));}
.nb.active span{color:var(--blue-bright);}
.nb:hover{background:rgba(59,130,246,.08);}
.nb.active::after{content:'';position:absolute;bottom:-8px;width:4px;height:4px;border-radius:50%;background:var(--blue-bright);box-shadow:0 0 6px var(--blue-bright);}
.nav-plus{width:54px;height:54px;background:linear-gradient(140deg,var(--blue),var(--blue-sky));border-radius:50%;display:flex;align-items:center;justify-content:center;cursor:pointer;box-shadow:0 0 28px var(--blue-glow),0 4px 20px rgba(0,0,0,.5);transition:transform .2s,box-shadow .2s;margin-bottom:4px;}
.nav-plus:hover{transform:scale(1.09) rotate(45deg);box-shadow:0 0 40px rgba(59,130,246,.5);}
.nav-plus:active{transform:scale(.94);}
.nav-plus svg{width:26px;height:26px;stroke:#fff;stroke-width:2.5;}

/* TYPOGRAPHY */
.vt{font-family:'Instrument Serif',serif;font-size:38px;line-height:1.05;letter-spacing:-.5px;background:linear-gradient(140deg,#fff 20%,var(--blue-bright));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;}
.vs{font-size:13px;color:var(--text-muted);margin-top:3px;}
.sec-label{font-size:10px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:var(--text-muted);margin:22px 20px 10px;opacity:.8;}

/* CARDS */
.card{background:var(--card);border:1px solid var(--card-border);border-radius:var(--r);padding:20px;position:relative;overflow:hidden;transition:border-color .3s,box-shadow .3s;}
.card:hover{border-color:rgba(59,130,246,.18);}
.card::before{content:'';position:absolute;inset:0;background:linear-gradient(140deg,rgba(59,130,246,.03),transparent 60%);pointer-events:none;}

/* HOME HERO */
.hero{margin:52px 18px 0;background:linear-gradient(140deg,rgba(14,165,233,.09),rgba(59,130,246,.14));border:1px solid rgba(59,130,246,.2);border-radius:28px;padding:34px;text-align:center;position:relative;overflow:hidden;}
.hero::after{content:'';position:absolute;top:-60px;left:50%;transform:translateX(-50%);width:250px;height:250px;background:radial-gradient(circle,rgba(59,130,246,.12),transparent);pointer-events:none;}
.hero-pct{font-family:'Instrument Serif',serif;font-size:96px;line-height:1;background:linear-gradient(140deg,#fff 30%,var(--blue-bright));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;filter:drop-shadow(0 0 30px rgba(96,165,250,.3));}
.hero-lbl{font-size:10px;letter-spacing:2.5px;color:var(--text-muted);margin-top:6px;text-transform:uppercase;}
.hero-sub{font-size:17px;color:var(--text-dim);margin-top:10px;font-weight:300;}

/* WEEK CAL */
.wcal{display:flex;justify-content:space-between;margin:14px 18px 0;gap:5px;}
.wd{flex:1;display:flex;flex-direction:column;align-items:center;gap:5px;padding:9px 3px;border-radius:14px;transition:all .2s;cursor:default;}
.wd-n{font-size:10px;color:var(--text-muted);font-weight:600;text-transform:uppercase;}
.wd-d{width:33px;height:33px;display:flex;align-items:center;justify-content:center;border-radius:50%;font-size:14px;font-weight:500;color:var(--text-dim);}
.wd.today .wd-d{background:linear-gradient(140deg,var(--blue),var(--blue-sky));color:#fff;box-shadow:0 0 14px var(--blue-glow);}
.wd .dot{width:5px;height:5px;border-radius:50%;background:var(--blue-bright);opacity:0;transition:opacity .3s;}
.wd.done .dot{opacity:1;}

/* HABIT ITEMS */
.hlist{padding:0 18px;margin-top:6px;}
.hi{display:flex;align-items:center;gap:13px;padding:15px;background:var(--card);border:1px solid var(--card-border);border-radius:18px;margin-bottom:9px;cursor:pointer;transition:all .28s cubic-bezier(.4,0,.2,1);position:relative;overflow:hidden;}
.hi::after{content:'';position:absolute;inset:0;background:linear-gradient(90deg,transparent,rgba(59,130,246,.025));pointer-events:none;}
.hi.done-h{background:rgba(59,130,246,.07);border-color:rgba(59,130,246,.28);}
.hi:hover{transform:translateX(3px);border-color:rgba(59,130,246,.2);}
.h-ico{width:46px;height:46px;border-radius:14px;background:rgba(255,255,255,.04);border:1px solid var(--card-border);display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:22px;transition:all .25s;}
.hi.done-h .h-ico{background:linear-gradient(140deg,rgba(59,130,246,.18),rgba(14,165,233,.18));border-color:rgba(59,130,246,.38);}
.h-info{flex:1;min-width:0;}
.h-nm{font-size:15px;font-weight:500;color:var(--text);}
.h-mt{font-size:12px;color:var(--text-muted);margin-top:2px;}
.h-cats{display:flex;gap:4px;margin-top:6px;flex-wrap:wrap;}
.hcat{font-size:10px;padding:2px 8px;border-radius:20px;font-weight:600;text-transform:uppercase;letter-spacing:.5px;}
.c-a{background:rgba(139,92,246,.13);color:#b794f4;border:1px solid rgba(139,92,246,.22);}
.c-p{background:rgba(34,197,94,.1);color:#4ade80;border:1px solid rgba(34,197,94,.2);}
.c-w{background:rgba(59,130,246,.1);color:#60a5fa;border:1px solid rgba(59,130,246,.2);}
.c-s{background:rgba(245,158,11,.1);color:#fbbf24;border:1px solid rgba(245,158,11,.2);}
.h-chk{width:30px;height:30px;border-radius:50%;border:2px solid var(--text-muted);display:flex;align-items:center;justify-content:center;flex-shrink:0;transition:all .32s cubic-bezier(.175,.885,.32,1.4);}
.hi.done-h .h-chk{background:linear-gradient(140deg,var(--blue),var(--blue-sky));border-color:transparent;box-shadow:0 0 16px var(--blue-glow);transform:scale(1.1);}
.h-chk svg{width:14px;height:14px;stroke:#fff;opacity:0;transition:opacity .2s;}
.hi.done-h .h-chk svg{opacity:1;}

/* RIPPLE */
@keyframes rpl{to{transform:scale(4.5);opacity:0;}}
.rpl{position:absolute;border-radius:50%;background:rgba(59,130,246,.25);animation:rpl .65s linear;pointer-events:none;}

/* STREAK / LEVEL */
.sbadge{display:inline-flex;align-items:center;gap:6px;padding:6px 14px;background:rgba(245,158,11,.09);border:1px solid rgba(245,158,11,.18);border-radius:100px;font-size:13px;font-weight:600;color:#fbbf24;}
.lvlbadge{display:inline-flex;align-items:center;gap:5px;padding:6px 14px;background:rgba(59,130,246,.1);border:1px solid rgba(59,130,246,.22);border-radius:100px;font-size:13px;font-weight:600;color:var(--blue-bright);}

/* BADGES */
.b-row{display:flex;gap:10px;overflow-x:auto;padding:2px 0 6px;scrollbar-width:none;}
.b-row::-webkit-scrollbar{display:none;}
.bi{flex-shrink:0;width:76px;display:flex;flex-direction:column;align-items:center;gap:6px;padding:13px 8px;background:var(--card);border:1px solid var(--card-border);border-radius:18px;transition:all .25s;text-align:center;}
.bi.earned{background:rgba(59,130,246,.07);border-color:rgba(59,130,246,.22);box-shadow:0 0 12px rgba(59,130,246,.08);}
.bi.locked{opacity:.28;filter:grayscale(.5);}
.bi-ico{font-size:30px;}
.bi-nm{font-size:9px;color:var(--text-muted);line-height:1.35;font-weight:500;}

/* HABITS MANAGE */
.hmi{display:flex;align-items:center;gap:12px;padding:14px 16px;background:var(--card);border:1px solid var(--card-border);border-radius:16px;margin-bottom:8px;transition:all .2s;}
.hmi:hover{border-color:rgba(59,130,246,.18);}
.hma{display:flex;gap:6px;}
.ib{width:34px;height:34px;border-radius:10px;border:1px solid var(--card-border);background:transparent;display:flex;align-items:center;justify-content:center;cursor:pointer;transition:all .2s;color:var(--text-muted);}
.ib:hover{background:rgba(255,255,255,.07);color:var(--text);}
.ib.del:hover{background:rgba(239,68,68,.1);color:#f87171;border-color:rgba(239,68,68,.2);}

/* STATS */
.srow{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:0 18px;}
.sbox{background:var(--card);border:1px solid var(--card-border);border-radius:var(--rs);padding:18px;text-align:center;}
.sbox-n{font-family:'Instrument Serif',serif;font-size:34px;background:linear-gradient(140deg,#fff,var(--blue-bright));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;}
.sbox-l{font-size:10px;color:var(--text-muted);margin-top:3px;text-transform:uppercase;letter-spacing:1px;}

/* RADAR */
.rc{margin:0 18px;background:var(--card);border:1px solid var(--card-border);border-radius:var(--r);padding:16px;}
.rc canvas{display:block;margin:0 auto;}

/* METRICS */
.mleg{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:12px 18px 0;}
.mitem{display:flex;align-items:center;gap:8px;padding:11px 14px;background:var(--card);border:1px solid var(--card-border);border-radius:12px;}
.mdot{width:10px;height:10px;border-radius:50%;flex-shrink:0;}
.mlbl{font-size:12px;font-weight:500;color:var(--text-dim);}
.mval{font-size:15px;font-weight:700;color:var(--text);margin-left:auto;}

/* HEATMAP */
.hmap-grid{display:grid;grid-template-rows:repeat(7,10px);grid-auto-flow:column;gap:3px;width:max-content;}
.hmc{width:10px;height:10px;border-radius:2px;background:rgba(255,255,255,.04);transition:background .3s;}
.hmc.l1{background:rgba(59,130,246,.18);}
.hmc.l2{background:rgba(59,130,246,.38);}
.hmc.l3{background:rgba(59,130,246,.6);}
.hmc.l4{background:rgba(59,130,246,.88);}

/* CHART */
.cw{position:relative;height:160px;margin:0 18px;}

/* TABS */
.tabs{display:flex;gap:3px;padding:4px;background:rgba(255,255,255,.035);border-radius:14px;margin:0 18px 14px;}
.tab{flex:1;padding:9px;text-align:center;font-size:12px;font-weight:600;color:var(--text-muted);border-radius:10px;cursor:pointer;transition:all .25s;}
.tab.active{background:rgba(59,130,246,.14);color:var(--blue-bright);box-shadow:0 0 12px rgba(59,130,246,.1);}

/* TIMER */
.timer-d{font-family:'Instrument Serif',serif;font-size:80px;line-height:1;background:linear-gradient(140deg,#fff,var(--blue-bright));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;filter:drop-shadow(0 0 24px rgba(96,165,250,.35));}
.t-btn{display:inline-flex;align-items:center;gap:8px;padding:15px 36px;border-radius:100px;font-size:15px;font-weight:700;cursor:pointer;border:none;font-family:'DM Sans',sans-serif;transition:all .25s cubic-bezier(.4,0,.2,1);letter-spacing:.3px;}
.t-bp{background:linear-gradient(140deg,var(--blue),var(--blue-sky));color:#fff;box-shadow:0 0 24px var(--blue-glow),0 2px 12px rgba(0,0,0,.4);}
.t-bp:hover{transform:translateY(-2px) scale(1.02);box-shadow:0 4px 36px rgba(59,130,246,.55);}
.t-bp:active{transform:scale(.97);}
.t-bs{background:rgba(255,255,255,.05);color:var(--text-dim);border:1px solid var(--card-border);}
.t-bs:hover{background:rgba(255,255,255,.08);color:var(--text);}
.adj-btn{width:46px;height:46px;border-radius:50%;background:rgba(255,255,255,.05);border:1px solid var(--card-border);color:var(--text-dim);font-size:18px;font-weight:700;display:flex;align-items:center;justify-content:center;cursor:pointer;transition:all .2s;}
.adj-btn:hover{background:rgba(59,130,246,.1);color:var(--blue-bright);border-color:rgba(59,130,246,.3);}

/* MARKS */
.sc{margin:0 18px 12px;background:var(--card);border:1px solid var(--card-border);border-radius:var(--r);overflow:hidden;transition:border-color .2s;}
.sc:hover{border-color:rgba(59,130,246,.15);}
.sh{display:flex;align-items:center;justify-content:space-between;padding:16px 20px;cursor:pointer;}
.snm{font-size:16px;font-weight:700;}
.savg{font-family:'Instrument Serif',serif;font-size:24px;color:var(--blue-bright);}
.me{display:flex;align-items:center;gap:10px;padding:8px 0;border-bottom:1px solid var(--card-border);}
.me:last-child{border-bottom:none;}
.mbw{flex:2;height:4px;background:rgba(255,255,255,.05);border-radius:2px;overflow:hidden;}
.mb{height:100%;border-radius:2px;transition:width .7s cubic-bezier(.4,0,.2,1);}

/* MODAL */
.mo{position:fixed;inset:0;background:rgba(0,0,0,.72);backdrop-filter:blur(10px);z-index:200;display:flex;align-items:flex-end;justify-content:center;opacity:0;pointer-events:none;transition:opacity .3s;}
.mo.open{opacity:1;pointer-events:all;}
.modal{background:#0a0a14;border:1px solid rgba(59,130,246,.13);border-radius:28px 28px 0 0;padding:26px 22px 44px;width:100%;max-width:600px;max-height:88vh;overflow-y:auto;transform:translateY(100%);transition:transform .36s cubic-bezier(.4,0,.2,1);scrollbar-width:none;}
.modal::-webkit-scrollbar{display:none;}
.mo.open .modal{transform:translateY(0);}
.mh{width:38px;height:4px;background:rgba(255,255,255,.13);border-radius:2px;margin:0 auto 22px;}
.mt{font-family:'Instrument Serif',serif;font-size:26px;margin-bottom:18px;background:linear-gradient(140deg,#fff,var(--blue-bright));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;}

/* FORM */
.fg{margin-bottom:15px;}
.fl{font-size:11px;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:.9px;margin-bottom:7px;display:block;}
.fi{width:100%;background:rgba(255,255,255,.04);border:1px solid var(--card-border);border-radius:12px;padding:12px 15px;color:var(--text);font-family:'DM Sans',sans-serif;font-size:15px;outline:none;transition:border-color .2s,box-shadow .2s;}
.fi:focus{border-color:var(--blue);box-shadow:0 0 0 3px rgba(59,130,246,.1);}
.fi::placeholder{color:var(--text-muted);}

/* DAY / CAT BTN */
.dsel{display:flex;gap:5px;}
.dbtn{width:38px;height:38px;border-radius:10px;background:rgba(255,255,255,.04);border:1px solid var(--card-border);color:var(--text-muted);font-size:12px;font-weight:700;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:all .2s;font-family:'DM Sans',sans-serif;}
.dbtn.sel{background:linear-gradient(140deg,rgba(59,130,246,.18),rgba(14,165,233,.18));border-color:var(--blue);color:var(--blue-bright);}
.csel{display:flex;gap:7px;flex-wrap:wrap;}
.cbtn{padding:8px 15px;border-radius:100px;font-size:12px;font-weight:600;cursor:pointer;border:1px solid var(--card-border);background:transparent;color:var(--text-muted);transition:all .2s;font-family:'DM Sans',sans-serif;}
.cbtn[data-cat="academics"].sel{background:rgba(139,92,246,.13);color:#b794f4;border-color:rgba(139,92,246,.35);}
.cbtn[data-cat="physique"].sel{background:rgba(34,197,94,.1);color:#4ade80;border-color:rgba(34,197,94,.28);}
.cbtn[data-cat="work"].sel{background:rgba(59,130,246,.1);color:#60a5fa;border-color:rgba(59,130,246,.28);}
.cbtn[data-cat="social"].sel{background:rgba(245,158,11,.1);color:#fbbf24;border-color:rgba(245,158,11,.28);}

/* BTNS */
.btn{display:inline-flex;align-items:center;gap:6px;padding:10px 20px;border-radius:100px;font-size:13px;font-weight:700;cursor:pointer;border:none;font-family:'DM Sans',sans-serif;transition:all .22s cubic-bezier(.4,0,.2,1);}
.btn-p{background:linear-gradient(140deg,var(--blue),var(--blue-sky));color:#fff;box-shadow:0 0 18px var(--blue-glow);}
.btn-p:hover{transform:translateY(-1px);box-shadow:0 3px 24px rgba(59,130,246,.55);}
.btn-g{background:transparent;color:var(--text-muted);border:1px solid var(--card-border);}
.btn-g:hover{background:rgba(255,255,255,.05);color:var(--text);}

/* TOAST */
.toast{position:fixed;bottom:calc(var(--nav-h)+18px);left:50%;transform:translateX(-50%) translateY(18px);background:rgba(10,10,20,.96);border:1px solid rgba(59,130,246,.25);border-radius:100px;padding:12px 22px;font-size:13px;font-weight:500;color:var(--text);z-index:300;opacity:0;transition:all .3s cubic-bezier(.4,0,.2,1);white-space:nowrap;backdrop-filter:blur(12px);box-shadow:0 4px 24px rgba(0,0,0,.4),0 0 24px rgba(59,130,246,.1);}
.toast.show{opacity:1;transform:translateX(-50%) translateY(0);}

/* ANIMATIONS */
@keyframes fadeUp{from{opacity:0;transform:translateY(14px);}to{opacity:1;transform:translateY(0);}}
@keyframes scaleIn{from{opacity:0;transform:scale(.9);}to{opacity:1;transform:scale(1);}}
@keyframes spin{to{transform:rotate(360deg);}}
@keyframes pulse2{0%,100%{opacity:1;}50%{opacity:.45;}}
.fade-up{animation:fadeUp .4s ease both;}
.pulse-a{animation:pulse2 2s ease infinite;}

/* EMPTY */
.es{text-align:center;padding:50px 24px;color:var(--text-muted);}
.es-ico{font-size:50px;margin-bottom:14px;opacity:.45;}
.es-t{font-size:14px;line-height:1.6;}

/* PROGRESS RING */
.pr-bg{fill:none;stroke:rgba(255,255,255,.05);}
.pr-fg{fill:none;stroke:url(#blueGrd);stroke-linecap:round;transition:stroke-dashoffset 1.1s cubic-bezier(.4,0,.2,1);}
</style>
</head>
<body>

<div class="orb orb1"></div>
<div class="orb orb2"></div>
<div class="orb orb3"></div>

<div id="app">

  <!-- HOME -->
  <div class="view active" id="v-home">
    <div class="hero">
      <div class="hero-pct" id="heroPct">0%</div>
      <div class="hero-sub" id="heroSub">0 of 0 habits achieved</div>
      <div class="hero-lbl">HABITS ACHIEVED TODAY</div>
    </div>
    <div class="wcal" id="wcal"></div>
    <div style="margin:14px 18px 0;display:flex;align-items:center;gap:8px;">
      <div class="sbadge" id="streakB">🔥 0 day streak</div>
      <div id="lvlB" style="margin-left:auto;"></div>
    </div>
    <div class="sec-label">TODAY'S HABITS</div>
    <div class="hlist" id="todayH"></div>
    <div class="sec-label">ACHIEVEMENTS</div>
