let tDur=25*60,tRem=25*60,tRun=false,tIv=null,sessStart=null,studyTab='day';
let studyCI=null;

function adjT(m){
  if(tRun)return;
  tDur=Math.max(5*60,Math.min(180*60,tDur+m*60));
  tRem=tDur;updTDisp();
  document.getElementById('tDurL').textContent=`${Math.round(tDur/60)} min`;
}
function updTDisp(){
  const m=String(Math.floor(tRem/60)).padStart(2,'0');
  const s=String(tRem%60).padStart(2,'0');
  document.getElementById('tDisp').textContent=`${m}:${s}`;
  const circ=2*Math.PI*118;
  const off=circ*(1-(tRem/tDur));
  const ring=document.getElementById('tRing');
  if(ring)ring.style.strokeDashoffset=off;
  document.getElementById('tStat').textContent=tRun?'Focusing…':(tRem===tDur?'Ready':'Paused');
  document.getElementById('tStartB').textContent=tRun?'Pause':(tRem<tDur?'Resume':'Start');
}
function toggleT(){
  if(tRun){
    clearInterval(tIv);tRun=false;
    if(sessStart){const e=Math.round((Date.now()-sessStart)/1000);if(e>10)saveSess(e);sessStart=null;}
  }else{
    tRun=true;sessStart=Date.now();
    tIv=setInterval(()=>{
      tRem--;updTDisp();
      if(tRem<=0){
        clearInterval(tIv);tRun=false;
        if(sessStart){saveSess(tDur);sessStart=null;}
        toast('Session complete! Great work 🎉','⏰');
        updTodaySt();rStudyC(studyTab);tRem=tDur;updTDisp();
      }
    },1000);
  }updTDisp();
}
function resetT(){
  clearInterval(tIv);
  if(tRun&&sessStart){const e=Math.round((Date.now()-sessStart)/1000);if(e>10)saveSess(e);sessStart=null;}
  tRun=false;tRem=tDur;updTDisp();
}
function saveSess(sec){
  const ds=todayS();
  const ex=sessions.find(x=>x.date===ds);
  if(ex)ex.sec+=sec;else sessions.push({date:ds,sec});
  S('sessions',sessions);checkBadges();
}
function updTodaySt(){
  const ds=todayS();
  const s=sessions.find(x=>x.date===ds);
  document.getElementById('todaySt').textContent=fmtSec(s?s.sec:0);
}
function swStudy(el,tab){
  document.querySelectorAll('#v-timer .tab').forEach(t=>t.classList.remove('active'));
  el.classList.add('active');studyTab=tab;rStudyC(tab);
}
function rStudyC(tab){
  const canvas=document.getElementById('studyC');if(!canvas)return;
  if(studyCI){studyCI.destroy();studyCI=null;}
  let labels=[],data=[];
  const today=new Date();
  if(tab==='day'){
    for(let i=6;i>=0;i--){const d=new Date(today);d.setDate(today.getDate()-i);const ds=d.toISOString().split('T')[0];const s=sessions.find(x=>x.date===ds);labels.push(d.toLocaleDateString('en',{weekday:'short'}));data.push(s?+(s.sec/3600).toFixed(2):0);}
  }else if(tab==='week'){
    for(let i=3;i>=0;i--){let tot=0;const ws=new Date(today);ws.setDate(today.getDate()-((today.getDay()+6)%7)-i*7);for(let j=0;j<7;j++){const d=new Date(ws);d.setDate(ws.getDate()+j);const s=sessions.find(x=>x.date===d.toISOString().split('T')[0]);if(s)tot+=s.sec;}labels.push('Wk '+(4-i));data.push(+(tot/3600).toFixed(2));}
  }else if(tab==='month'){
    for(let i=5;i>=0;i--){const d=new Date(today);d.setMonth(today.getMonth()-i);const y=d.getFullYear(),mo=d.getMonth();let tot=0;sessions.forEach(s=>{const sd=new Date(s.date+'T00:00:00');if(sd.getFullYear()===y&&sd.getMonth()===mo)tot+=s.sec;});labels.push(d.toLocaleDateString('en',{month:'short'}));data.push(+(tot/3600).toFixed(2));}
  }else{
    for(let i=11;i>=0;i--){const d=new Date(today);d.setMonth(today.getMonth()-i);const y=d.getFullYear(),mo=d.getMonth();let tot=0;sessions.forEach(s=>{const sd=new Date(s.date+'T00:00:00');if(sd.getFullYear()===y&&sd.getMonth()===mo)tot+=s.sec;});labels.push(d.toLocaleDateString('en',{month:'short'}));data.push(+(tot/3600).toFixed(2));}
  }
  studyCI=new Chart(canvas,{type:'bar',data:{labels,datasets:[{data,backgroundColor:data.map(v=>v>0?'rgba(59,130,246,0.62)':'rgba(255,255,255,0.04)'),borderColor:data.map(v=>v>0?'rgba(96,165,250,0.9)':'rgba(255,255,255,0.08)'),borderWidth:1,borderRadius:7,borderSkipped:false}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false},tooltip:{backgroundColor:'rgba(8,8,18,.95)',borderColor:'rgba(59,130,246,.25)',borderWidth:1,titleColor:'#94a3b8',bodyColor:'#f0f4ff',callbacks:{label:ctx=>`${ctx.raw}h studied`}}},scales:{x:{grid:{color:'rgba(255,255,255,.03)'},ticks:{color:'#5a6a8a',font:{family:'DM Sans',size:11}}},y:{grid:{color:'rgba(255,255,255,.03)'},ticks:{color:'#5a6a8a',font:{family:'DM Sans',size:11},callback:v=>v+'h'},beginAtZero:true}}}});
}

