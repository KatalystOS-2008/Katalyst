let radarAnim=null;
function drawRadar(progress){
  const canvas=document.getElementById('radC');if(!canvas)return;
  const ctx=canvas.getContext('2d');
  const W=canvas.width,H=canvas.height,cx=W/2,cy=H/2;
  const maxR=Math.min(W,H)*0.36;
  ctx.clearRect(0,0,W,H);
  const cats=[
    {key:'academics',lbl:'🎓 Academics',col:'#b794f4',angle:-Math.PI/2},
    {key:'physique',lbl:'💪 Physique',col:'#4ade80',angle:0},
    {key:'social',lbl:'🤝 Social',col:'#fbbf24',angle:Math.PI/2},
    {key:'work',lbl:'💼 Work',col:'#60a5fa',angle:Math.PI},
  ];
  const maxV=Math.max(10,...Object.values(radar));
  // rings
  for(let i=1;i<=5;i++){
    const r=i/5*maxR;
    ctx.beginPath();
    cats.forEach((c,ci)=>{const x=cx+r*Math.cos(c.angle),y=cy+r*Math.sin(c.angle);ci?ctx.lineTo(x,y):ctx.moveTo(x,y);});
    ctx.closePath();ctx.strokeStyle='rgba(255,255,255,0.055)';ctx.lineWidth=1;ctx.stroke();
  }
  // axes
  cats.forEach(c=>{ctx.beginPath();ctx.moveTo(cx,cy);ctx.lineTo(cx+maxR*Math.cos(c.angle),cy+maxR*Math.sin(c.angle));ctx.strokeStyle='rgba(255,255,255,0.07)';ctx.lineWidth=1;ctx.stroke();});
  // data polygon
  const vals=cats.map(c=>(radar[c.key]||0)/maxV*progress);
  ctx.beginPath();
  cats.forEach((c,ci)=>{const r=vals[ci]*maxR,x=cx+r*Math.cos(c.angle),y=cy+r*Math.sin(c.angle);ci?ctx.lineTo(x,y):ctx.moveTo(x,y);});
  ctx.closePath();
  const grd=ctx.createRadialGradient(cx,cy,0,cx,cy,maxR);
  grd.addColorStop(0,'rgba(59,130,246,0.28)');grd.addColorStop(1,'rgba(14,165,233,0.08)');
  ctx.fillStyle=grd;ctx.fill();
  ctx.strokeStyle='rgba(96,165,250,0.75)';ctx.lineWidth=2.5;ctx.stroke();
  // dots
  cats.forEach((c,ci)=>{
    const r=vals[ci]*maxR,x=cx+r*Math.cos(c.angle),y=cy+r*Math.sin(c.angle);
    ctx.beginPath();ctx.arc(x,y,5.5,0,Math.PI*2);
    ctx.fillStyle=c.col;ctx.fill();ctx.strokeStyle='#0a0a14';ctx.lineWidth=2;ctx.stroke();
  });
  // labels
  ctx.font='500 12px DM Sans';
  cats.forEach(c=>{
    const lx=cx+(maxR+28)*Math.cos(c.angle),ly=cy+(maxR+28)*Math.sin(c.angle);
    ctx.fillStyle='#8898aa';
    ctx.textAlign=Math.cos(c.angle)>0.1?'left':Math.cos(c.angle)<-0.1?'right':'center';
    ctx.textBaseline=Math.sin(c.angle)>0.1?'top':Math.sin(c.angle)<-0.1?'bottom':'middle';
    ctx.fillText(c.lbl,lx,ly);
  });
  // animate
  if(progress<1){
    if(radarAnim)cancelAnimationFrame(radarAnim);
    radarAnim=requestAnimationFrame(()=>drawRadar(Math.min(progress+0.05,1)));
  }
}

// ── INIT ──────────────────────────────────────────────────────────────────
if(!G('sdate',null))S('sdate',todayS());
rHome();rDSel();rCSel();
</script>
