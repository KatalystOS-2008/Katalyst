<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Winged Nikka</title>

<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600&family=Inter:wght@300;400;500&display=swap" rel="stylesheet">

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script src="https://www.paypal.com/sdk/js?client-id=YOUR_PAYPAL_CLIENT_ID&currency=USD"></script>

<style>

/* BASE */
body{margin:0;font-family:Inter;background:#F6F2EC;color:#111;}
h1,h2,h3{font-family:Playfair Display;font-weight:400;}

/* NAV */
.nav{display:flex;justify-content:space-between;padding:25px 80px;border-bottom:1px solid #ddd;}
.nav a{margin-left:25px;text-decoration:none;color:#000;font-size:13px;}

/* HERO */
.hero{display:grid;grid-template-columns:1fr 1fr;padding:100px;align-items:center;}
.hero h1{font-size:80px;line-height:1.05;}
.hero img{width:100%;border-radius:150px;}

/* CATEGORIES */
.categories{display:grid;grid-template-columns:repeat(3,1fr);gap:50px;padding:80px 100px;}
.category-card img{width:100%;border-radius:8px;transition:0.4s;}
.category-card:hover img{transform:scale(1.05);}
.category-card{text-align:center;}
.category-card button{border:none;background:none;border-bottom:1px solid black;cursor:pointer;margin-top:8px;}

/* PRODUCTS */
.products-view{display:none;padding:80px;}
.product-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:40px;}
.product-card img{width:100%;cursor:pointer;transition:0.4s;}
.product-card:hover img{transform:scale(1.06);}

/* DETAIL */
.product-detail{display:none;padding:80px;max-width:700px;}
.product-detail button{margin-top:20px;padding:10px;border:1px solid #000;background:none;cursor:pointer;}

/* CUSTOM */
.custom-card{margin:100px;padding:40px;border:1px solid #ddd;display:flex;justify-content:space-between;}
.custom-card button{border:1px solid black;background:none;padding:10px 20px;cursor:pointer;}

/* MODAL */
.modal{position:fixed;inset:0;background:rgba(0,0,0,0.5);display:none;justify-content:center;align-items:center;}
.modal-content{background:white;padding:30px;width:400px;position:relative;}
.close{position:absolute;top:10px;right:15px;cursor:pointer;}
#price{position:absolute;top:10px;left:15px;}

.step{display:none;margin-top:30px;}
.step button{width:100%;margin:10px 0;padding:10px;border:1px solid #ccc;background:none;cursor:pointer;}
.step button:hover{background:black;color:white;}

/* FOOTER */
footer{padding:80px;display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid #ddd;}

/* MOBILE */
@media(max-width:768px){
.hero{grid-template-columns:1fr;padding:50px;}
.hero h1{font-size:50px;}
.categories{grid-template-columns:1fr;padding:40px;}
.product-grid{grid-template-columns:1fr;}
}

</style>
</head>

<body>

<!-- NAV -->
<div class="nav">
<div>WN</div>
<div>
<a href="#">About</a>
<a href="#">Collection</a>
<a href="#">Shop</a>
</div>
</div>

<!-- HERO -->
<section class="hero">
<div>
<h1>classy<br>and<br>fabulous.</h1>
</div>
<img src="https://images.unsplash.com/photo-1617038220319-276d3cfab638">
</section>

<!-- CATEGORIES -->
<section class="categories">
<div class="category-card">
<img src="https://images.unsplash.com/photo-1602751584552-8ba73aad10e1">
<h3>Wedding Jewelry</h3>
<button onclick="openCategory('Necklaces')">Shop Now</button>
</div>

<div class="category-card">
<img src="https://images.unsplash.com/photo-1617038220319-276d3cfab638">
<h3>Custom Design</h3>
<button onclick="openCustomizer()">Customize</button>
</div>

<div class="category-card">
<img src="https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f">
<h3>New Collection</h3>
<button onclick="openCategory('Bracelets')">Shop Now</button>
</div>
</section>

<!-- PRODUCTS -->
<section id="productsView" class="products-view">
<button onclick="goHome()">← Back</button>
<div id="productGrid" class="product-grid"></div>
</section>

<!-- DETAIL -->
<section id="productDetail" class="product-detail">
<button onclick="backToProducts()">← Back</button>
<div id="detailContent"></div>
<div id="paypal-cart"></div>
</section>

<!-- CUSTOM -->
<div class="custom-card">
<div>
<h3>Custom Jewelry</h3>
<p>Create your own piece</p>
</div>
<button onclick="openCustomizer()">Customize Yours</button>
</div>

<!-- MODAL -->
<div id="customModal" class="modal">
<div class="modal-content">
<span class="close" onclick="closeCustomizer()">×</span>
<div id="price">$0</div>

<div id="step1" class="step">
<h3>Type</h3>
<button onclick="nextStep(2,10)">Necklace</button>
<button onclick="nextStep(2,8)">Bracelet</button>
</div>

<div id="step2" class="step">
<h3>Material</h3>
<button onclick="nextStep(3,5)">Opal</button>
<button onclick="nextStep(3,7)">Turquoise</button>
</div>

<div id="step3" class="step">
<h3>Pendant</h3>
<button onclick="nextStep(4,6)">Heart</button>
<button onclick="nextStep(4,6)">Turtle</button>
</div>

<div id="step4" class="step">
<h3>Plating</h3>
<button onclick="nextStep(5,15)">Gold</button>
<button onclick="nextStep(5,10)">Silver</button>
</div>

<div id="step5" class="step">
<h3>Checkout</h3>
<input placeholder="Name">
<input placeholder="Email">
<div id="paypal-custom"></div>
</div>

</div>
</div>

<footer>
<div>Social</div>
<div>Menu</div>
<div>Contact</div>
<div>Newsletter</div>
</footer>

<script>

/* STATE */
let cart = JSON.parse(localStorage.getItem("cart")) || [];
let total = 0;

/* NAV */
function openCategory(cat){
document.querySelector(".hero").style.display="none";
document.querySelector(".categories").style.display="none";
productsView.style.display="block";
loadProducts(cat);
}

function goHome(){
document.querySelector(".hero").style.display="grid";
document.querySelector(".categories").style.display="grid";
productsView.style.display="none";
productDetail.style.display="none";
}

function backToProducts(){
productsView.style.display="block";
productDetail.style.display="none";
}

/* CUSTOM */
function openCustomizer(){
customModal.style.display="flex";
total=0;
updatePrice();
showStep(1);
}
function closeCustomizer(){customModal.style.display="none";}
function showStep(n){
document.querySelectorAll(".step").forEach(s=>s.style.display="none");
document.getElementById("step"+n).style.display="block";
}
function nextStep(n,price){
total+=price;
updatePrice();
showStep(n);
}
function updatePrice(){price.innerText="$"+total;}

/* SUPABASE */
const supabaseClient = supabase.createClient(
"https://gpubgxknzrsqduenhscj.supabase.co",
"sb_publishable_pDmzDdCW56kOUVAvYJEp-g_CmRCAQtw"
);

async function loadProducts(category){
const {data}=await supabaseClient.from('products').select('*').eq('category',category);
productGrid.innerHTML="";
data.forEach(p=>{
let div=document.createElement("div");
div.className="product-card";
div.innerHTML=`<img src="${p.image_url}">`;
div.onclick=()=>showDetail(p);
productGrid.appendChild(div);
});
}

function showDetail(p){
productsView.style.display="none";
productDetail.style.display="block";
detailContent.innerHTML=`
<h2>${p.name}</h2>
<p>${p.description}</p>
<p>$${p.price}</p>
<button onclick='addToCart(${JSON.stringify(p)})'>Add to Cart</button>
`;
}

/* CART */
function addToCart(p){
let e=cart.find(i=>i.id===p.id);
if(e){e.quantity++;}else{cart.push({...p,quantity:1});}
localStorage.setItem("cart",JSON.stringify(cart));
alert("Added to cart");
}

/* PAYPAL CART */
paypal.Buttons({
createOrder:(d,a)=>{
let t=cart.reduce((s,i)=>s+i.price*i.quantity,0);
return a.order.create({purchase_units:[{amount:{value:t.toFixed(2)}}}]});
},
onApprove:(d,a)=>a.order.capture().then(()=>{
alert("Payment successful");
cart=[];
localStorage.setItem("cart","[]");
})
}).render('#paypal-cart');

/* PAYPAL CUSTOM */
paypal.Buttons({
createOrder:(d,a)=>{
return a.order.create({purchase_units:[{amount:{value:total.toFixed(2)}}}]});
},
onApprove:(d,a)=>a.order.capture().then(()=>{
alert("Custom order placed");
closeCustomizer();
})
}).render('#paypal-custom');

</script>

</body>
</html>