<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Strategex Hussain — Meta Ads Performance Marketer</title>
<link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet"/>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"/>
<style>
  :root {
    --black:    #080810;
    --deep:     #0d0d18;
    --card:     #11111e;
    --blue:     #1877F2;
    --blue-glow:#4a9eff;
    --yellow:   #FFD600;
    --white:    #f4f4ee;
    --muted:    #7a7a90;
    --border:   rgba(255,255,255,0.07);
  }

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; }

  body {
    font-family: 'Poppins', sans-serif;
    background: var(--deep);
    color: var(--white);
    overflow-x: hidden;
    cursor: none;
  }

  /* ── CURSOR ─────────────────────────── */
  #cursor {
    width: 10px; height: 10px;
    background: var(--yellow); border-radius: 50%;
    position: fixed; top: 0; left: 0;
    pointer-events: none; z-index: 9999;
    transform: translate(-50%,-50%);
    transition: width .3s, height .3s, background .3s;
  }
  #cursor-ring {
    width: 34px; height: 34px;
    border: 1.5px solid var(--blue-glow); border-radius: 50%;
    position: fixed; top: 0; left: 0;
    pointer-events: none; z-index: 9998;
    transform: translate(-50%,-50%);
  }

  /* ── NAV ─────────────────────────────── */
  nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 200;
    padding: 22px 56px;
    display: flex; align-items: center; justify-content: space-between;
    background: rgba(8,8,16,0.75);
    backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--border);
  }
  .nav-logo {
    font-family: 'Instrument Serif', serif;
    font-size: 1.5rem; color: var(--white); text-decoration: none;
  }
  .nav-logo span { color: var(--yellow); }
  .nav-links { display: flex; gap: 40px; list-style: none; }
  .nav-links a {
    font-size: 0.72rem; letter-spacing: 1.5px; text-transform: uppercase;
    color: var(--muted); text-decoration: none; font-weight: 500;
    transition: color .3s;
  }
  .nav-links a:hover { color: var(--white); }
  .nav-cta {
    background: var(--yellow); color: var(--black);
    font-family: 'Poppins', sans-serif;
    font-size: 0.72rem; letter-spacing: 1.5px; text-transform: uppercase;
    font-weight: 700; padding: 11px 26px; border-radius: 4px;
    border: none; cursor: none;
    transition: transform .25s, box-shadow .3s;
  }
  .nav-cta:hover { transform: translateY(-2px); box-shadow: 0 8px 28px rgba(255,214,0,.28); }

  /* ── HERO ────────────────────────────── */
  .hero {
    min-height: 100vh;
    display: grid; grid-template-columns: 1fr 1fr;
    align-items: center;
    padding: 140px 56px 80px;
    position: relative; overflow: hidden;
  }
  .hero-glow {
    position: absolute; inset: 0; pointer-events: none;
    background:
      radial-gradient(ellipse 55% 55% at 72% 50%, rgba(24,119,242,.13) 0%, transparent 65%),
      radial-gradient(ellipse 35% 40% at 15% 75%, rgba(255,214,0,.07) 0%, transparent 55%);
  }
  .hero-grid {
    position: absolute; inset: 0;
    background-image:
      linear-gradient(rgba(255,255,255,.022) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,.022) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: radial-gradient(ellipse 80% 80% at 50% 50%, black, transparent);
  }
  .hero-left { position: relative; z-index: 2; }

  .hero-badge {
    display: inline-flex; align-items: center; gap: 10px;
    font-size: 0.68rem; letter-spacing: 2.5px; text-transform: uppercase;
    color: var(--blue-glow);
    border: 1px solid rgba(74,158,255,.28);
    padding: 8px 18px; border-radius: 100px;
    margin-bottom: 36px;
    animation: fadeUp .8s ease both;
  }
  .hero-badge i { font-size: 0.55rem; animation: blink 2s infinite; }
  @keyframes blink { 0%,100%{opacity:1} 50%{opacity:.25} }

  h1 {
    font-family: 'Instrument Serif', serif;
    font-size: clamp(3.4rem, 6.5vw, 6.5rem);
    line-height: 1.06; letter-spacing: -1px;
    animation: fadeUp .9s .08s ease both;
  }
  h1 em { font-style: italic; color: var(--yellow); }
  h1 .outline { -webkit-text-stroke: 1.5px var(--white); color: transparent; }

  .hero-sub {
    margin-top: 26px;
    font-size: .93rem; color: var(--muted); line-height: 1.85;
    max-width: 500px; font-weight: 400;
    animation: fadeUp .9s .16s ease both;
  }
  .hero-ctas {
    display: flex; gap: 14px; margin-top: 40px; flex-wrap: wrap;
    animation: fadeUp .9s .24s ease both;
  }
  .btn-primary {
    display: inline-flex; align-items: center; gap: 10px;
    background: var(--yellow); color: var(--black);
    font-size: .75rem; letter-spacing: 1.5px; text-transform: uppercase;
    font-weight: 700; padding: 15px 30px; border-radius: 5px;
    text-decoration: none; border: none; cursor: none;
    transition: transform .25s, box-shadow .3s;
  }
  .btn-primary:hover { transform: translateY(-3px); box-shadow: 0 12px 36px rgba(255,214,0,.3); }
  .btn-primary i { transition: transform .3s; }
  .btn-primary:hover i { transform: translate(3px,-3px); }
  .btn-outline {
    display: inline-flex; align-items: center; gap: 10px;
    background: transparent; color: var(--white);
    font-size: .75rem; letter-spacing: 1.5px; text-transform: uppercase;
    font-weight: 600; padding: 15px 30px; border-radius: 5px;
    text-decoration: none; border: 1px solid rgba(255,255,255,.18);
    cursor: none; transition: border-color .3s, background .3s;
  }
  .btn-outline:hover { border-color: var(--blue-glow); background: rgba(74,158,255,.07); }

  .hero-stats {
    display: flex; gap: 0; margin-top: 64px;
    animation: fadeUp .9s .32s ease both;
  }
  .stat {
    padding: 0 44px 0 0; margin-right: 44px;
    border-right: 1px solid var(--border);
  }
  .stat:last-child { border-right: none; margin-right: 0; padding-right: 0; }
  .stat-val {
    font-family: 'Instrument Serif', serif;
    font-size: 3rem; line-height: 1; color: var(--white);
  }
  .stat-val em { color: var(--yellow); font-style: normal; }
  .stat-lbl { font-size: .62rem; letter-spacing: 2px; text-transform: uppercase; color: var(--muted); margin-top: 5px; }

  /* hero right card */
  .hero-right {
    position: relative; z-index: 2;
    display: flex; justify-content: flex-end; align-items: center;
  }
  .hero-card-main {
    background: var(--card); border: 1px solid var(--border);
    border-radius: 20px; padding: 44px; width: 340px;
    position: relative; box-shadow: 0 32px 80px rgba(0,0,0,.5);
    animation: fadeUp .9s .2s ease both;
  }
  .hero-card-main::before {
    content: ''; position: absolute; top: 0; left: 24px; right: 24px; height: 2px;
    background: linear-gradient(90deg, var(--blue), var(--yellow));
    border-radius: 0 0 4px 4px;
  }
  .hcard-label { font-size: .62rem; letter-spacing: 2px; text-transform: uppercase; color: var(--muted); margin-bottom: 20px; }
  .hcard-big { font-family: 'Instrument Serif', serif; font-size: 3.8rem; color: var(--yellow); line-height: 1; }
  .hcard-sub { font-size: .85rem; color: var(--muted); margin-top: 8px; line-height: 1.6; }
  .hcard-divider { height: 1px; background: var(--border); margin: 24px 0; }
  .hcard-row { display: flex; justify-content: space-between; }
  .hcard-mini-val { font-family: 'Instrument Serif', serif; font-size: 1.6rem; color: var(--white); }
  .hcard-mini-lbl { font-size: .65rem; color: var(--muted); margin-top: 2px; }

  .hero-card-float {
    position: absolute; bottom: -32px; left: -60px;
    background: var(--card); border: 1px solid rgba(255,214,0,.2);
    border-radius: 14px; padding: 20px 24px;
    display: flex; align-items: center; gap: 14px;
    box-shadow: 0 16px 48px rgba(0,0,0,.4);
    animation: fadeUp 1s .4s ease both;
  }
  .float-icon {
    width: 40px; height: 40px; border-radius: 10px;
    background: rgba(255,214,0,.12);
    display: flex; align-items: center; justify-content: center;
    color: var(--yellow); font-size: 1rem;
  }
  .float-text { font-size: .78rem; font-weight: 600; }
  .float-sub { font-size: .65rem; color: var(--muted); margin-top: 2px; }

  /* ── TICKER ──────────────────────────── */
  .ticker { background: var(--yellow); padding: 13px 0; overflow: hidden; }
  .ticker-track { display: flex; animation: ticker 24s linear infinite; white-space: nowrap; }
  .ticker-item {
    font-family: 'Instrument Serif', serif; font-style: italic;
    font-size: 1.05rem; padding: 0 48px; flex-shrink: 0; color: var(--black);
    display: flex; align-items: center; gap: 12px;
  }
  .ticker-item i { font-size: .55rem; color: rgba(0,0,0,.38); font-style: normal; }
  @keyframes ticker { 0%{transform:translateX(0)} 100%{transform:translateX(-50%)} }

  /* ── SECTIONS ────────────────────────── */
  section { padding: 110px 56px; }
  .sec-label { font-size: .62rem; letter-spacing: 3px; text-transform: uppercase; color: var(--blue-glow); margin-bottom: 14px; }
  .sec-title {
    font-family: 'Instrument Serif', serif;
    font-size: clamp(2.4rem, 4.5vw, 4rem); line-height: 1.1; margin-bottom: 18px;
  }
  .sec-title em { font-style: italic; color: var(--yellow); }
  .sec-title .dim { color: rgba(255,255,255,.25); }
  .sec-title .outline { -webkit-text-stroke: 1.5px var(--white); color: transparent; }

  /* ── RESULTS ─────────────────────────── */
  .results { background: var(--black); }
  .results-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 2px; margin-top: 60px; }
  .res-card {
    background: var(--card); padding: 48px 40px;
    position: relative; overflow: hidden; transition: transform .3s;
  }
  .res-card::after {
    content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px;
    background: linear-gradient(90deg, var(--blue), var(--yellow));
    transform: scaleX(0); transform-origin: left; transition: transform .4s ease;
  }
  .res-card:hover::after { transform: scaleX(1); }
  .res-card:hover { transform: translateY(-5px); }
  .res-icon {
    width: 52px; height: 52px; border-radius: 12px;
    background: rgba(24,119,242,.1); border: 1px solid rgba(74,158,255,.2);
    display: flex; align-items: center; justify-content: center;
    color: var(--blue-glow); font-size: 1.1rem; margin-bottom: 28px;
  }
  .res-big { font-family: 'Instrument Serif', serif; font-size: 3.6rem; color: var(--yellow); line-height: 1; }
  .res-desc { font-size: .88rem; color: var(--muted); margin-top: 14px; line-height: 1.75; }
  .res-pill {
    display: inline-block; margin-top: 22px;
    font-size: .6rem; letter-spacing: 2px; text-transform: uppercase;
    background: rgba(24,119,242,.1); color: var(--blue-glow);
    border: 1px solid rgba(74,158,255,.2); padding: 6px 14px; border-radius: 100px;
  }

  /* ── SERVICES ────────────────────────── */
  .services-wrap { display: grid; grid-template-columns: 1fr 1.7fr; gap: 80px; align-items: start; margin-top: 60px; }
  .svc-list { display: flex; flex-direction: column; gap: 4px; }
  .svc-item {
    padding: 22px 26px; border: 1px solid var(--border); border-radius: 8px;
    cursor: none; transition: border-color .3s, background .3s;
    display: flex; align-items: center; gap: 18px;
  }
  .svc-item:hover, .svc-item.active { border-color: var(--blue-glow); background: rgba(24,119,242,.05); }
  .svc-item.active .svc-num { color: var(--yellow); }
  .svc-num { font-family: 'Instrument Serif', serif; font-size: 1.5rem; color: rgba(255,255,255,.12); transition: color .3s; min-width: 38px; }
  .svc-name { font-size: .92rem; font-weight: 600; }
  .svc-name i { margin-right: 10px; font-size: .8rem; color: var(--muted); transition: color .3s; }
  .svc-item.active .svc-name i, .svc-item:hover .svc-name i { color: var(--blue-glow); }

  .svc-detail {
    background: var(--card); border: 1px solid var(--border);
    border-radius: 16px; padding: 52px;
    position: sticky; top: 110px; min-height: 360px;
    display: flex; flex-direction: column; justify-content: center;
  }
  .svc-detail-icon {
    width: 60px; height: 60px; border-radius: 14px;
    background: rgba(74,158,255,.1); border: 1px solid rgba(74,158,255,.2);
    display: flex; align-items: center; justify-content: center;
    color: var(--blue-glow); font-size: 1.4rem; margin-bottom: 28px;
  }
  .svc-detail-title { font-family: 'Instrument Serif', serif; font-size: 2rem; margin-bottom: 16px; }
  .svc-detail-desc { color: var(--muted); font-size: .9rem; line-height: 1.85; }
  .svc-tags { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 28px; }
  .stag {
    font-size: .6rem; letter-spacing: 1.5px; text-transform: uppercase; font-weight: 600;
    background: rgba(255,214,0,.08); color: var(--yellow);
    border: 1px solid rgba(255,214,0,.18); padding: 6px 14px; border-radius: 100px;
  }

  /* ── WHY ME ──────────────────────────── */
  .why { background: var(--black); }
  .why-grid { display: grid; grid-template-columns: repeat(2,1fr); gap: 24px; margin-top: 60px; }
  .why-card {
    padding: 44px; border: 1px solid var(--border); border-radius: 14px;
    transition: transform .3s, border-color .3s; position: relative; overflow: hidden;
  }
  .why-card::before {
    content: ''; position: absolute; top: 0; left: 0; bottom: 0; width: 2px;
    background: linear-gradient(180deg, var(--blue), transparent);
    transform: scaleY(0); transform-origin: top; transition: transform .4s ease;
  }
  .why-card:hover { transform: translateY(-5px); border-color: rgba(74,158,255,.25); }
  .why-card:hover::before { transform: scaleY(1); }
  .why-ico {
    width: 50px; height: 50px; border-radius: 12px;
    background: rgba(24,119,242,.1); border: 1px solid rgba(74,158,255,.18);
    display: flex; align-items: center; justify-content: center;
    color: var(--blue-glow); font-size: 1.1rem; margin-bottom: 24px;
  }
  .why-title { font-size: .98rem; font-weight: 700; margin-bottom: 12px; }
  .why-desc { color: var(--muted); font-size: .87rem; line-height: 1.8; }

  /* ── VS SECTION ──────────────────────── */
  .vs-section { position: relative; overflow: hidden; }
  .vs-watermark {
    position: absolute; top: 50%; left: 50%; transform: translate(-50%,-50%);
    font-family: 'Instrument Serif', serif;
    font-size: 20vw; color: rgba(255,255,255,.018); white-space: nowrap; pointer-events: none;
  }
  .vs-grid {
    display: grid; grid-template-columns: 1fr auto 1fr;
    gap: 32px; align-items: center; margin-top: 60px; position: relative; z-index: 2;
  }
  .vs-box { background: var(--card); border: 1px solid var(--border); border-radius: 18px; padding: 48px 40px; }
  .vs-box.bad { opacity: .55; }
  .vs-box.good { border-color: rgba(255,214,0,.22); background: rgba(255,214,0,.03); }
  .vs-box-lbl { font-size: .6rem; letter-spacing: 2.5px; text-transform: uppercase; margin-bottom: 16px; }
  .vs-box.bad .vs-box-lbl { color: #ff6b6b; }
  .vs-box.good .vs-box-lbl { color: var(--yellow); }
  .vs-box-title { font-family: 'Instrument Serif', serif; font-size: 1.9rem; margin-bottom: 20px; }
  .vs-box.bad .vs-box-title { text-decoration: line-through; color: var(--muted); }
  .vs-list { list-style: none; display: flex; flex-direction: column; gap: 13px; }
  .vs-list li { font-size: .88rem; color: var(--muted); display: flex; align-items: flex-start; gap: 12px; line-height: 1.5; }
  .vs-list li i { margin-top: 3px; flex-shrink: 0; }
  .vs-sep { font-family: 'Instrument Serif', serif; font-size: 2.8rem; font-style: italic; color: var(--yellow); text-align: center; }

  /* ── PROCESS ─────────────────────────── */
  .process-bg { background: var(--black); }
  .process-steps { display: flex; gap: 0; margin-top: 60px; position: relative; }
  .process-steps::before {
    content: ''; position: absolute; top: 34px; left: 64px; right: 64px; height: 1px;
    background: linear-gradient(90deg, transparent, var(--blue-glow) 30%, var(--yellow) 70%, transparent);
  }
  .step { flex: 1; padding: 28px 24px; text-align: center; position: relative; }
  .step-num {
    width: 68px; height: 68px; background: var(--card); border: 1px solid var(--border); border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-family: 'Instrument Serif', serif; font-size: 1.6rem; color: var(--yellow);
    margin: 0 auto 24px; position: relative; z-index: 2;
    transition: border-color .3s, box-shadow .3s;
  }
  .step:hover .step-num { border-color: var(--yellow); box-shadow: 0 0 28px rgba(255,214,0,.25); }
  .step-title { font-size: .9rem; font-weight: 700; margin-bottom: 10px; }
  .step-icon { color: var(--blue-glow); margin-right: 7px; font-size: .8rem; }
  .step-desc { font-size: .82rem; color: var(--muted); line-height: 1.75; }

  /* ── CTA ─────────────────────────────── */
  .cta-sec {
    background: var(--yellow); color: var(--black);
    text-align: center; padding: 110px 56px;
    position: relative; overflow: hidden;
  }
  .cta-overlay {
    position: absolute; inset: 0;
    background-image:
      linear-gradient(rgba(0,0,0,.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0,0,0,.04) 1px, transparent 1px);
    background-size: 44px 44px;
  }
  .cta-inner { position: relative; z-index: 2; }
  .cta-sec .sec-label { color: rgba(0,0,0,.45); }
  .cta-sec .sec-title { color: var(--black); }
  .cta-sec .sec-title .outline { -webkit-text-stroke: 1.5px var(--black); color: transparent; }
  .cta-sub { color: rgba(0,0,0,.55); font-size: .92rem; line-height: 1.8; max-width: 460px; margin: 14px auto 0; }
  .cta-form { display: flex; gap: 10px; max-width: 480px; margin: 36px auto 0; }
  .cta-input {
    flex: 1; padding: 15px 20px;
    background: rgba(0,0,0,.1); border: 1.5px solid rgba(0,0,0,.18);
    border-radius: 5px; font-family: 'Poppins', sans-serif;
    font-size: .9rem; color: var(--black); outline: none; transition: border-color .3s;
  }
  .cta-input::placeholder { color: rgba(0,0,0,.38); }
  .cta-input:focus { border-color: var(--black); }
  .btn-dark {
    background: var(--black); color: var(--yellow);
    font-family: 'Poppins', sans-serif;
    font-size: .72rem; letter-spacing: 1.5px; text-transform: uppercase;
    font-weight: 700; padding: 15px 26px; border-radius: 5px;
    border: none; cursor: none; white-space: nowrap;
    display: flex; align-items: center; gap: 8px;
    transition: transform .2s, box-shadow .3s;
  }
  .btn-dark:hover { transform: translateY(-2px); box-shadow: 0 8px 28px rgba(0,0,0,.3); }
  .cta-note { margin-top: 18px; font-size: .62rem; letter-spacing: 2px; text-transform: uppercase; color: rgba(0,0,0,.38); }

  /* ── FOOTER ──────────────────────────── */
  footer {
    background: var(--black); padding: 48px 56px;
    display: flex; align-items: center; justify-content: space-between;
    border-top: 1px solid var(--border);
  }
  .footer-logo { font-family: 'Instrument Serif', serif; font-size: 1.3rem; }
  .footer-logo span { color: var(--yellow); }
  .footer-tagline { font-size: .62rem; letter-spacing: 2px; text-transform: uppercase; color: var(--muted); margin-top: 4px; }
  .footer-links { display: flex; gap: 32px; list-style: none; }
  .footer-links a {
    font-size: .65rem; letter-spacing: 1.5px; text-transform: uppercase;
    color: var(--muted); text-decoration: none; transition: color .3s;
  }
  .footer-links a:hover { color: var(--white); }
  .footer-copy { font-size: .65rem; color: var(--muted); }

  /* ── ANIMATIONS ──────────────────────── */
  @keyframes fadeUp { from{opacity:0;transform:translateY(32px)} to{opacity:1;transform:translateY(0)} }
  .reveal { opacity:0; transform:translateY(36px); transition:opacity .7s ease, transform .7s ease; }
  .reveal.visible { opacity:1; transform:none; }
  .d1{transition-delay:.1s} .d2{transition-delay:.2s} .d3{transition-delay:.3s} .d4{transition-delay:.4s}

  /* ── RESPONSIVE ──────────────────────── */
  @media(max-width:900px){
    nav{padding:16px 24px} .nav-links{display:none}
    section{padding:80px 24px}
    .hero{grid-template-columns:1fr;padding:130px 24px 60px;gap:56px}
    .hero-right{justify-content:flex-start}
    .results-grid{grid-template-columns:1fr}
    .services-wrap{grid-template-columns:1fr;gap:36px}
    .why-grid{grid-template-columns:1fr}
    .vs-grid{grid-template-columns:1fr} .vs-sep{display:none}
    .process-steps{flex-direction:column} .process-steps::before{display:none}
    .hero-stats{flex-direction:column;gap:24px}
    .stat{border-right:none;padding:0;margin:0}
    footer{flex-direction:column;gap:28px;text-align:center}
    .cta-form{flex-direction:column}
    .hero-card-float{left:0;bottom:-20px}
  }
</style>
</head>
<body>

<div id="cursor"></div>
<div id="cursor-ring"></div>

<!-- NAV -->
<nav>
