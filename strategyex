<script>
/* Cursor */
const cur=document.getElementById('cursor'),ring=document.getElementById('cursor-ring');
let mx=0,my=0,rx=0,ry=0;
document.addEventListener('mousemove',e=>{mx=e.clientX;my=e.clientY;cur.style.left=mx+'px';cur.style.top=my+'px';});
(function loop(){rx+=(mx-rx)*.12;ry+=(my-ry)*.12;ring.style.left=rx+'px';ring.style.top=ry+'px';requestAnimationFrame(loop);})();
document.querySelectorAll('a,button,.svc-item,.why-card,.res-card,.step').forEach(el=>{
  el.addEventListener('mouseenter',()=>{cur.style.width='22px';cur.style.height='22px';cur.style.background='var(--blue-glow)';});
  el.addEventListener('mouseleave',()=>{cur.style.width='10px';cur.style.height='10px';cur.style.background='var(--yellow)';});
});

/* Scroll reveal */
const obs=new IntersectionObserver(entries=>{entries.forEach(e=>{if(e.isIntersecting)e.target.classList.add('visible');});},{threshold:.1});
document.querySelectorAll('.reveal').forEach(el=>obs.observe(el));

/* Services */
const svcData=[
  {icon:'fa-brands fa-meta',title:'Meta Ads Strategy',desc:"Full-stack Meta advertising strategy built around your revenue goals — not impressions. I map the buying journey, identify the highest-intent audiences, and build a campaign architecture designed to scale profitably.",tags:['Facebook Ads','Instagram Ads','Reels Ads','Retargeting']},
  {icon:'fa-solid fa-gears',title:'Campaign Management',desc:'Day-to-day campaign management with proactive optimisation. I monitor performance hourly, adjust bids and budgets, pause underperformers, and scale winners — so your account always runs at peak efficiency.',tags:['Daily Optimisation','Budget Control','Bid Strategy','Performance Reporting']},
  {icon:'fa-solid fa-flask',title:'Creative Testing',desc:'Systematic creative testing using a proven framework. I test hooks, visuals, CTAs, and formats — static, video, carousel, Reels — to find the combinations that stop the scroll and convert browsers to buyers.',tags:['A/B Testing','Video Ads','Static Creatives','UGC Strategy']},
  {icon:'fa-solid fa-users-viewfinder',title:'Audience Research',desc:'Precision audience segmentation using interest stacking, behavioural targeting, lookalike modelling, and first-party data. I find the people most likely to buy and put your offer directly in front of them.',tags:['Lookalike Audiences','Interest Targeting','Custom Audiences','Retargeting Lists']},
  {icon:'fa-solid fa-filter-circle-dollar',title:'Funnel Optimisation',desc:"Meta ads don't work in a vacuum. I optimise the entire post-click experience — landing pages, offers, and conversion flows — to ensure every click has the highest possible chance of turning into revenue.",tags:['Landing Page CRO','Offer Structuring','Pixel Setup','Attribution']}
];
document.querySelectorAll('.svc-item').forEach(item=>{
  item.addEventListener('click',()=>{
    document.querySelectorAll('.svc-item').forEach(i=>i.classList.remove('active'));
    item.classList.add('active');
    const d=svcData[parseInt(item.dataset.i)];
    document.getElementById('detailIcon').innerHTML=`<i class="${d.icon}"></i>`;
    document.getElementById('detailTitle').textContent=d.title;
    document.getElementById('detailDesc').textContent=d.desc;
    document.getElementById('detailTags').innerHTML=d.tags.map(t=>`<span class="stag">${t}</span>`).join('');
  });
});

/* Counters */
function countTo(el,end,dur,pre,suf){
  let t=null;
  (function step(ts){
    if(!t)t=ts;
    const p=Math.min((ts-t)/dur,1);
    el.innerHTML=`${pre}${Math.floor(p*end)}<em>${suf}</em>`;
    if(p<1)requestAnimationFrame(step);
  })(performance.now());
}
const so=new IntersectionObserver(entries=>{
  entries.forEach(e=>{
    if(e.isIntersecting){
      countTo(document.getElementById('s1'),10,1400,'','x');
      countTo(document.getElementById('s2'),400,1500,'$','K');
      countTo(document.getElementById('s3'),50,1200,'','+');
      so.disconnect();
    }
  });
},{threshold:.5});
const hs=document.querySelector('.hero-stats');
if(hs)so.observe(hs);

/* CTA */
function handleCTA(){
  const inp=document.getElementById('emailInput');
  if(inp.value&&inp.value.includes('@')){inp.value='';inp.placeholder='Received — I\'ll be in touch shortly.';}
  else{inp.style.borderColor='#e55';inp.placeholder='Please enter a valid email.';setTimeout(()=>{inp.style.borderColor='';inp.placeholder='Your business email';},2200);}
}
</script>
