            <div className="row-header">
              <div><p className="section-label">Our Favourites</p><h2 className="section-title">Best<em>sellers</em></h2></div>
              <span className="view-link">View All Pieces →</span>
            </div>
            <div className="products-grid">
              {PRODUCTS.map(p => (
                <div key={p.id} className="product-card" onClick={() => openProduct(p)}>
                  <div className="pcard-img">
                    <div className="pcard-img-inner"><img src={p.images[0]} alt={p.name} /></div>
                    {p.tag && <span className="product-tag">{p.tag}</span>}
                  </div>
                  <p className="pcard-name">{p.name}</p>
                  <p className="pcard-mat">{p.material}</p>
                  <p className="pcard-price">${p.price}</p>
                </div>
              ))}
            </div>
          </section>

          {/* COLLECTIONS */}
          <section className="section collections" id="coll-sec">
            <div style={{display:'flex',justifyContent:'space-between',alignItems:'flex-end'}}>
              <div><p className="section-label">Explore</p><h2 className="section-title">Our <em>Collections</em></h2></div>
              <span className="view-link">All Collections →</span>
            </div>
            <div className="coll-grid">
              {COLLECTIONS.map((c,i) => (
                <div key={i} className="coll-card">
                  <div className="coll-card-img"><img src={c.img} alt={c.name} /></div>
                  <div className="coll-overlay">
                    <span className="coll-lbl">{c.sub}</span>
                    <h3 className="coll-name">{c.name} <em>Collection</em></h3>
                    <div className="coll-explore"><span className="coll-line" />Explore</div>
                  </div>
                </div>
              ))}
            </div>
          </section>

          {/* PHILOSOPHY */}
          <section className="philosophy" id="phil-sec">
            <div className="phil-left">
              <p className="phil-lbl">Our Philosophy</p>
              <h2 className="phil-title">Jewellery that<br />tells your <em>story</em></h2>
              <p className="phil-text">Winged Nika was born from a belief that jewellery should be more than an accessory — a reflection of your most authentic self. Every piece is handcrafted in our London studio using responsibly sourced materials and time-honoured techniques.</p>
              <button className="phil-cta">Discover Our Story →</button>
            </div>
            <div className="phil-right">
              <img src={PHIL_IMG} alt="Our studio" />
              <div className="phil-deco">W</div>
              <div className="phil-stats">
                {[{n:'6+',d:'Years of Craft'},{n:'2K+',d:'Pieces Created'},{n:'40+',d:'Countries Shipped'},{n:'100%',d:'Handmade'}].map(s => (
                  <div key={s.d} className="stat-box"><div className="stat-num">{s.n}</div><div className="stat-desc">{s.d}</div></div>
                ))}
              </div>
            </div>
          </section>

          {/* TESTIMONIALS */}
          <section className="section testimonials" id="test-sec">
            <div className="test-header">
              <p className="section-label" style={{textAlign:'center'}}>Customer Stories</p>
              <h2 className="section-title" style={{textAlign:'center',maxWidth:'460px',margin:'0 auto'}}>Words from our <em>community</em></h2>
            </div>
            <div className="test-grid">
              {[
                {t:"The Celestia Ring is beyond anything I expected. The craftsmanship is extraordinary — I wear it every day and it never fails to draw compliments.",a:"Isabelle M. — London"},
                {t:"I ordered the Aurora Necklace as a gift for my daughter. She was moved to tears. The quality and attention to detail is truly unmatched.",a:"Clara V. — Paris"},
                {t:"After trying many brands, Winged Nika is the only one I keep returning to. You can feel the handcraft and intention in every detail.",a:"Sophia R. — New York"},
              ].map((r,i) => (
                <div key={i} className="test-card">
                  <div className="test-stars">★★★★★</div>
                  <p className="test-text">"{r.t}"</p>
                  <p className="test-author">{r.a}</p>
                </div>
              ))}
            </div>
          </section>

          {/* NEW ARRIVALS */}
          <section className="section new-arrivals" id="newin-sec">
            <div className="row-header">
              <div><p className="section-label">Just Landed</p><h2 className="section-title">New <em>Arrivals</em></h2></div>
              <span className="view-link">Shop New Arrivals →</span>
            </div>
            <div className="products-grid">
              {PRODUCTS.slice(2,6).map(p => (
                <div key={p.id} className="product-card" onClick={() => openProduct(p)}>
                  <div className="pcard-img">
                    <div className="pcard-img-inner"><img src={p.images[0]} alt={p.name} /></div>
                    {p.tag && <span className="product-tag">{p.tag}</span>}
                  </div>
                  <p className="pcard-name">{p.name}</p>
                  <p className="pcard-mat">{p.material}</p>
                  <p className="pcard-price">${p.price}</p>
                </div>
              ))}
            </div>
          </section>

          {/* NEWSLETTER */}
          <section className="newsletter">
            <div className="nl-content">
              <p className="nl-lbl">Join Our World</p>
              <h2 className="nl-title">Beauty delivered<br />to your inbox</h2>
              <p className="nl-sub">New collections, exclusive offers & stories from our studio</p>
              <div className="nl-form">
                <input className="nl-input" type="email" placeholder="Your email address" />
                <button className="nl-btn">Subscribe</button>
              </div>
            </div>
          </section>

          {/* FOOTER */}
          <footer className="footer">
            <div className="footer-top">
              <div className="footer-brand">
                <h3>Winged <span>Nika</span></h3>
                <p>Handcrafted fine jewellery made with love in our London studio. Each piece tells a story — yours.</p>
              </div>
              {[{title:"Shop",links:["All Jewellery","Rings","Necklaces","Earrings","Bracelets","Cuffs"]},{title:"Company",links:["Our Story","Sustainability","Press","Careers","Journal","Contact"]},{title:"Support",links:["Sizing Guide","Care Guide","Shipping","Returns","Custom Orders","Gift Cards"]}].map(col => (
                <div key={col.title} className="footer-col">
                  <h4>{col.title}</h4>
                  <ul>{col.links.map(l => <li key={l}><a>{l}</a></li>)}</ul>
                </div>
              ))}
            </div>
            <div className="footer-bottom">
              <p className="footer-copy">© 2025 Winged Nika. All rights reserved. Crafted with ♥ in London.</p>
              <div className="footer-socials">{["Instagram","Pinterest","Facebook","TikTok"].map(s => <a key={s}>{s}</a>)}</div>
            </div>
          </footer>
        </>
      )}
    </div>
  );
}
